<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mobilna.MainPage"
             >

    <StackLayout Margin="20">
        <Label Text="Właściwości czcionki" HorizontalOptions="Fill" BackgroundColor="#558B2F" TextColor="White" FontSize="Large" FontAttributes="Bold"></Label>
        <Label x:Name="rozmiar" Text="Rozmiar:" HorizontalOptions="Fill" FontSize="Medium"></Label>
        <Slider x:Name="suwak" Maximum="40" ValueChanged="OnValueChanged"></Slider>
        <Label x:Name="napisCytatu" HorizontalOptions="Fill" Text="Dzień dobry"></Label>
        <Button Clicked="Clicked" Text=">>" BackgroundColor="#558B2F" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" ></Button>
    </StackLayout>
</ContentPage>
